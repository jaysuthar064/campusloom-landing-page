# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# ---------------------------------------------------------------
# WordPress (cms/)
# Core is disposable - it can be re-downloaded any time. Only our
# own plugins/themes and uploads are worth tracking.
# ---------------------------------------------------------------
cms/*
!cms/wp-content/
cms/wp-content/*
!cms/wp-content/plugins/
!cms/wp-content/themes/
cms/wp-content/plugins/*
cms/wp-content/themes/*
cms/wp-content/upgrade/
cms/wp-content/uploads/

# ...except the code we actually write. Third-party plugins stay ignored;
# they are reinstallable from the WordPress directory.
!cms/wp-content/plugins/smartshala-cms/

# Local credentials and DB dumps
cms/wp-config.php
*.sql
*.sql.gz

# Auto-login shortcut — contains a machine-local admin token
Open WP Admin.url

# WP-CLI binary (re-downloadable)
tools/wp-cli.phar
